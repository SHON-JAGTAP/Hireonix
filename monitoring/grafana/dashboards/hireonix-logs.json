{
  "uid": "hireonix-logs",
  "title": "Hireonix Logs and Errors",
  "tags": ["hireonix", "logs", "errors"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "hireonix-loki"
        },
        "query": "label_values({container=~\"college_.*\"}, compose_service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors in selected period",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "hireonix-loki"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=~\"college_.*\", compose_service=~\"$service\"} | json | level=\"error\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors over time",
      "gridPos": {"h": 5, "w": 18, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "hireonix-loki"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (count_over_time({container=~\"college_.*\", compose_service=~\"$service\"} | json | level=\"error\" [$__interval]))",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Application errors",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5},
      "datasource": {"type": "loki", "uid": "hireonix-loki"},
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"college_.*\", compose_service=~\"$service\"} |~ \"(?i)error|exception|failed|failure\""
        }
      ],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLines": false, "prettifyLogMessage": true, "enableLogDetails": true}
    },
    {
      "id": 4,
      "type": "logs",
      "title": "All container logs",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 15},
      "datasource": {"type": "loki", "uid": "hireonix-loki"},
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"college_.*\", compose_service=~\"$service\"}"
        }
      ],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLines": true, "prettifyLogMessage": true, "enableLogDetails": true}
    }
  ]
}
